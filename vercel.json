{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/pbi", "destination": "/banking-crm", "permanent": true },
    { "source": "/pbi/:path*", "destination": "/banking-crm/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
